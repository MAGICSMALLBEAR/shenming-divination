{
  "expo": {
    "name": "神明占卜",
    "slug": "shenming-divination",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "shenmingdivination",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.shenming.divination",
      "buildNumber": "1",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "用於將您的提問語音轉換為文字。錄音只在辨識期間暫存。"
      }
    },
    "android": {
      "package": "com.shenming.divination",
      "versionCode": 1,
      "permissions": ["RECORD_AUDIO"],
      "adaptiveIcon": {
        "backgroundColor": "#1C0E06",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1C0E06",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 200
          },
          "ios": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 200
          }
        }
      ],
      "expo-audio",
      "expo-asset",
      [
        "@sentry/react-native",
        {
          "organization": "shenming-divination",
          "project": "shenming-app"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "允許神明占卜讀取行事曆，以選擇可寫入的行事曆。",
          "writeOnlyCalendarPermission": "允許神明占卜將神明紀念日加入你的行事曆。"
        }
      ],
      "expo-sharing",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
